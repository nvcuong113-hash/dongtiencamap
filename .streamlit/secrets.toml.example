# Copy values into Streamlit Cloud > App settings > Secrets.
GEMINI_API_KEY = "replace-with-a-new-key"
# Alternative provider:
# OPENAI_API_KEY = "replace-with-your-openai-key"
# OPENAI_MODEL = "gpt-4o-mini"
# Optional free Vnstock Community key for automated KBS/VCI fallback
# VNSTOCK_API_KEY = "add-your-free-vnstock-api-key-here"

# DNSE LightSpeed Market Data (read-only). Configure in Streamlit Cloud > Settings > Secrets.
# Never commit actual values; use a newly rotated key pair if credentials were exposed.
DNSE_API_KEY = "replace-with-dnse-api-key"
DNSE_API_SECRET = "replace-with-dnse-api-secret"
DNSE_API_VERSION = "2026-07-23"
DNSE_ENABLE_MARKET_DATA = "true"
# Keep shadow-only until feed quality is verified over multiple sessions.
DNSE_USE_FOR_DECISIONS = "false"
DNSE_QUOTE_CACHE_SECONDS = "15"
DNSE_PRICE_DISPLAY_THRESHOLD = "300"
DNSE_DEFAULT_BOARD_ID = "G1"
DNSE_DAILY_RESOLUTION = "1D"
